# OAuth client credentials Claude will use
OAUTH_CLIENT_ID=claude-mcp-client
OAUTH_CLIENT_SECRET=change-me-strong-secret

# Static access token issued to Claude after OAuth handshake
# Generate with: openssl rand -hex 32
PROXY_ACCESS_TOKEN=your-generated-access-token

# Coolify upstream
COOLIFY_MCP_URL=https://coolify.example.com/mcp
COOLIFY_BEARER_TOKEN=your-coolify-api-token

# Cloudflare Zero Trust service token (CF Dashboard → Access → Service Tokens)
CF_ACCESS_CLIENT_ID=your-service-token-id.access
CF_ACCESS_CLIENT_SECRET=your-service-token-secret

# Public URL of this proxy (no trailing slash)
PUBLIC_URL=https://mcp-proxy.example.com

# Port (optional, default 3000)
PORT=3000
